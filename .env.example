# Demo mode requires no credentials. Put actual keys in .env, not this template.
# auto: Anthropic if configured, otherwise Gemini if configured.
# Use gemini or anthropic explicitly when both keys are present.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Live public-source research still requires a separate search key.
TAVILY_API_KEY=
CLEARDILIGENCE_DB=data/cleardiligence.db

# Ordered, deduplicated recovery models. Up to three alternatives.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.7-flash
# Optional authorized backup credential for authentication failure (not quota rotation).
GEMINI_BACKUP_API_KEY=
# Legacy GEMINI_FALLBACK_MODEL is supported when the ordered setting is absent.

# Optional licensed OpenCorporates company search. Leave empty for manual handoff.
OPENCORPORATES_API_TOKEN=
# TLOxp, CLEAR and Factiva currently use manual analyst handoffs, not API keys.
